{
	menuDef
	{
		name					"splitscreen_start"
		visible					1
		fullscreen				1
		rect					0 0 640 480
		focusColor				1 1 1 1
		style					WINDOW_STYLE_FILLED
		backcolor				0.02 0.03 0.05 1

		onOpen
		{
			setcvar				"ui_splitScreenP1Input" "keyboard" ;
			setcvar				"ui_splitScreenP2Input" "controller1" ;
			setcvar				"ui_splitScreenP3Input" "controller2" ;
			setcvar				"ui_splitScreenP4Input" "controller3" ;
			uiScript			RefreshSplitScreenSessionType ;
			uiScript			RefreshSplitScreenPlayerCount ;
			uiScript			RefreshSplitScreenLayout ;
			uiScript			RefreshSplitScreenInputs ;
		}

		onESC
		{
			close				splitscreen_start ;
			open				multiplayermenu
		}

		itemDef { name title text "LOCAL SPLIT SCREEN" rect 70 28 500 30 type ITEM_TYPE_TEXT font 3 textscale .9 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 250 textaligny 2 forecolor .549 .854 1 1 visible 1 decoration }
		itemDef { name currentplayers text "SELECTED: 2 PLAYERS" rect 80 62 480 18 type ITEM_TYPE_TEXT font 2 textscale .55 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 240 textaligny 0 forecolor .75 .88 1 1 visible 1 decoration }

		itemDef
		{
			name				players2
			text				"2"
			rect				170 88 80 28
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			font				2
			textscale			.85
			textstyle			3
			textalign			ITEM_ALIGN_CENTER
			textalignx			40
			textaligny			2
			forecolor			1 .682 0 1
			backcolor			.18 .32 .50 .95
			visible				1
			action { uiScript SplitScreenSelectPlayerCount 2 ; }
		}

		itemDef
		{
			name				players3
			text				"3"
			rect				280 88 80 28
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			font				2
			textscale			.85
			textstyle			3
			textalign			ITEM_ALIGN_CENTER
			textalignx			40
			textaligny			2
			forecolor			1 .682 0 1
			backcolor			.08 .10 .16 .9
			visible				1
			action { uiScript SplitScreenSelectPlayerCount 3 ; }
		}

		itemDef
		{
			name				players4
			text				"4"
			rect				390 88 80 28
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			font				2
			textscale			.85
			textstyle			3
			textalign			ITEM_ALIGN_CENTER
			textalignx			40
			textaligny			2
			forecolor			1 .682 0 1
			backcolor			.08 .10 .16 .9
			visible				1
			action { uiScript SplitScreenSelectPlayerCount 4 ; }
		}

		itemDef { name typecard rect 40 126 560 70 style WINDOW_STYLE_FILLED border 1 backcolor .06 .08 .12 .86 bordercolor .20 .22 .35 1 visible 1 decoration }
		itemDef { name typetitle text "PLAY TYPE" rect 52 134 242 14 type ITEM_TYPE_TEXT font 2 textscale .5 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 121 textaligny 0 forecolor 1 .682 0 1 visible 1 decoration }
		itemDef { name typelocal text "LOCAL MATCH" rect 52 150 116 25 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .5 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 58 textaligny 1 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 action { uiScript SplitScreenSelectSessionType local ; } }
		itemDef { name typeparty text "SERVER PARTY" rect 176 150 118 25 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .5 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 59 textaligny 1 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenSelectSessionType server ; } }
		itemDef { name partytext text "Begin starts a local split-screen match." rect 52 179 274 12 type ITEM_TYPE_TEXT font 2 textscale .32 forecolor .75 .88 1 .85 visible 1 decoration }

		itemDef { name layouttitle text "2-PLAYER SCREEN LAYOUT" rect 340 134 244 14 type ITEM_TYPE_TEXT font 2 textscale .5 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 122 textaligny 0 forecolor 1 .682 0 1 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "2" } decoration }
		itemDef { name layouttopbottom text "TOP / BOTTOM" rect 340 150 116 25 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .44 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 58 textaligny 1 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "2" } action { uiScript SplitScreenSelectLayout horizontal ; } }
		itemDef { name layoutleftright text "LEFT / RIGHT" rect 464 150 120 25 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .44 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 60 textaligny 1 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "2" } action { uiScript SplitScreenSelectLayout vertical ; } }
		itemDef { name layoutfixed text "3- AND 4-PLAYER PARTIES USE A GRID LAYOUT" rect 326 146 258 24 type ITEM_TYPE_TEXT font 2 textscale .4 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 129 textaligny 1 forecolor .75 .88 1 .85 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } decoration }

		itemDef { name controltitle text "CONTROLLER SELECTION" rect 70 204 500 20 type ITEM_TYPE_TEXT font 2 textscale .65 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 250 textaligny 0 forecolor 1 .682 0 1 visible 1 decoration }

		itemDef { name p1card rect 40 234 560 34 style WINDOW_STYLE_FILLED border 1 backcolor .08 .10 .14 .88 bordercolor .298 .305 .690 1 visible 1 decoration }
		itemDef { name p1title text "PLAYER 1" rect 54 243 80 16 type ITEM_TYPE_TEXT font 2 textscale .52 textstyle 3 forecolor 1 .682 0 1 visible 1 decoration }
		itemDef { name p1assignment text "Keyboard + Mouse" rect 142 243 132 16 type ITEM_TYPE_TEXT font 2 textscale .46 forecolor .75 .88 1 1 visible 1 decoration }
		itemDef { name p1keyboard text "KEYBOARD" rect 282 239 76 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 38 textaligny 0 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 action { uiScript SplitScreenAssignInput 1 keyboard } }
		itemDef { name p1c1 text "CTRL 1" rect 364 239 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 1 controller1 } }
		itemDef { name p1c2 text "CTRL 2" rect 438 239 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 1 controller2 } }
		itemDef { name p1c3 text "CTRL 3" rect 512 239 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 1 controller3 } }

		itemDef { name p2card rect 40 278 560 34 style WINDOW_STYLE_FILLED border 1 backcolor .08 .10 .14 .88 bordercolor .298 .305 .690 1 visible 1 decoration }
		itemDef { name p2title text "PLAYER 2" rect 54 287 80 16 type ITEM_TYPE_TEXT font 2 textscale .52 textstyle 3 forecolor 1 .682 0 1 visible 1 decoration }
		itemDef { name p2assignment text "Controller 1" rect 142 287 132 16 type ITEM_TYPE_TEXT font 2 textscale .46 forecolor .75 .88 1 1 visible 1 decoration }
		itemDef { name p2keyboard text "KEYBOARD" rect 282 283 76 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 38 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 2 keyboard } }
		itemDef { name p2c1 text "CTRL 1" rect 364 283 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 action { uiScript SplitScreenAssignInput 2 controller1 } }
		itemDef { name p2c2 text "CTRL 2" rect 438 283 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 2 controller2 } }
		itemDef { name p2c3 text "CTRL 3" rect 512 283 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { uiScript SplitScreenAssignInput 2 controller3 } }

		itemDef { name p3card rect 40 322 560 34 style WINDOW_STYLE_FILLED border 1 backcolor .05 .07 .10 .82 bordercolor .20 .22 .35 1 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } decoration }
		itemDef { name p3title text "PLAYER 3" rect 54 331 80 16 type ITEM_TYPE_TEXT font 2 textscale .52 textstyle 3 forecolor 1 .682 0 .85 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } decoration }
		itemDef { name p3assignment text "Controller 2" rect 142 331 132 16 type ITEM_TYPE_TEXT font 2 textscale .46 forecolor .75 .88 1 .85 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } decoration }
		itemDef { name p3keyboard text "KEYBOARD" rect 282 327 76 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 38 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } action { uiScript SplitScreenAssignInput 3 keyboard } }
		itemDef { name p3c1 text "CTRL 1" rect 364 327 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } action { uiScript SplitScreenAssignInput 3 controller1 } }
		itemDef { name p3c2 text "CTRL 2" rect 438 327 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } action { uiScript SplitScreenAssignInput 3 controller2 } }
		itemDef { name p3c3 text "CTRL 3" rect 512 327 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "3"; "4" } action { uiScript SplitScreenAssignInput 3 controller3 } }

		itemDef { name p4card rect 40 366 560 34 style WINDOW_STYLE_FILLED border 1 backcolor .05 .07 .10 .82 bordercolor .20 .22 .35 1 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } decoration }
		itemDef { name p4title text "PLAYER 4" rect 54 375 80 16 type ITEM_TYPE_TEXT font 2 textscale .52 textstyle 3 forecolor 1 .682 0 .85 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } decoration }
		itemDef { name p4assignment text "Controller 3" rect 142 375 132 16 type ITEM_TYPE_TEXT font 2 textscale .46 forecolor .75 .88 1 .85 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } decoration }
		itemDef { name p4keyboard text "KEYBOARD" rect 282 371 76 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 38 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } action { uiScript SplitScreenAssignInput 4 keyboard } }
		itemDef { name p4c1 text "CTRL 1" rect 364 371 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } action { uiScript SplitScreenAssignInput 4 controller1 } }
		itemDef { name p4c2 text "CTRL 2" rect 438 371 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } action { uiScript SplitScreenAssignInput 4 controller2 } }
		itemDef { name p4c3 text "CTRL 3" rect 512 371 68 24 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .41 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 34 textaligny 0 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 cvarTest ui_splitScreenPlayerCount showCvar { "4" } action { uiScript SplitScreenAssignInput 4 controller3 } }

		itemDef { name next text "NEXT" rect 430 422 80 28 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .55 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 40 textaligny 1 forecolor 1 .682 0 1 backcolor .18 .32 .50 .95 visible 1 action { play "sound/interface/button1.wav" ; close splitscreen_start ; open splitscreen_players } }
		itemDef { name back text "BACK" rect 520 422 80 28 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED font 2 textscale .50 textstyle 3 textalign ITEM_ALIGN_CENTER textalignx 40 textaligny 1 forecolor 1 .682 0 1 backcolor .08 .10 .16 .9 visible 1 action { close splitscreen_start ; open multiplayermenu } }
	}
}
