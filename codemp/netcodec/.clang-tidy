# clang-tidy checks of netcodec: C++ Core Guidelines, bugs, performance, portability, part of modernize and
# readability (after cpp-best-practices/cmake_template). Disabled checks and why:
#  - magic numbers: the codec is made of format constants (widths, alphabet sizes) named where they matter;
#  - pro-bounds-constant-array-index, pro-bounds-avoid-unchecked-container-access: they ask for .at() or gsl::at,
#    which throw; netcodec uses no exceptions, std::span / std::array indices are checked in debug builds instead;
#  - pro-bounds-pointer-arithmetic: only in the byte-image accessors, through std::span;
#  - braces around single statements, one declaration per line, upper-case literal suffixes, #pragma once:
#    presentation only (every target compiler supports #pragma once);
#  - identifier length, trailing return types, cognitive complexity, trailing commas: style only.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-isolate-declaration,
  -readability-uppercase-literal-suffix,
  -readability-trailing-comma
WarningsAsErrors: ''
HeaderFilterRegex: '.*netcodec/(include|src)/.*'
FormatStyle: none
