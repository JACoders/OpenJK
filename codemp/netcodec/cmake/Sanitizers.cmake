# AddressSanitizer and UndefinedBehaviorSanitizer for the netcodec targets, after cpp-best-practices/cmake_template
# (cmake/Sanitizers.cmake). MSVC supports AddressSanitizer only. llvm-mingw (clang on Windows) supports both.
function(netcodec_enable_sanitizers target address undefined)
	set(list "")
	if(address)
		list(APPEND list "address")
	endif()
	if(undefined AND NOT MSVC)
		list(APPEND list "undefined")
	elseif(undefined)
		message(WARNING "netcodec: MSVC supports only the address sanitizer")
	endif()
	if(list STREQUAL "")
		return()
	endif()
	list(JOIN list "," sanitizers)
	if(MSVC)
		target_compile_options(${target} INTERFACE /fsanitize=${sanitizers} /Zi /INCREMENTAL:NO)
		target_compile_definitions(${target} INTERFACE _DISABLE_VECTOR_ANNOTATION _DISABLE_STRING_ANNOTATION)
		target_link_options(${target} INTERFACE /INCREMENTAL:NO)
	else()
		target_compile_options(${target} INTERFACE -fsanitize=${sanitizers} -fno-omit-frame-pointer -fno-sanitize-recover=all)
		target_link_options(${target} INTERFACE -fsanitize=${sanitizers})
	endif()
endfunction()
