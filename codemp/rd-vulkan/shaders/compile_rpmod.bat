@echo off
rem OpenJK-rpmod: compiles only the shaders in glsl\rpmod (the cinematic camera's depth of field and
rem filter) into spirv\shader_data_rpmod.c, which vk_shaders.cpp includes. Needs the Vulkan SDK
rem (glslangValidator); tools\bin2hex.exe is built by compile.bat, or here if it's missing.

setlocal
cd /d "%~dp0"

if "%VULKAN_SDK%"=="" (
    echo VULKAN_SDK isn't set: install the Vulkan SDK from vulkan.lunarg.com
    exit /b 1
)
set cl="%VULKAN_SDK%\Bin\glslangValidator.exe"
set bh=tools\bin2hex.exe
set tmpf=spirv\rpmod.spv
set outf=spirv\shader_data_rpmod.c

if not exist %bh% (
    cl.exe /EHsc /nologo /Fetools\ /Fotools\ tools\bin2hex.c || exit /b 1
)

echo // this file is generated by compile_rpmod.bat from glsl\rpmod> %outf%

call :frag rpmod_depth_frag_spv glsl\rpmod\depth.frag || exit /b 1
call :frag rpmod_depth_ms_frag_spv glsl\rpmod\depth.frag -DUSE_MSAA || exit /b 1
call :frag rpmod_dof_frag_spv glsl\rpmod\dof.frag || exit /b 1
call :frag rpmod_filter_frag_spv glsl\rpmod\filter.frag || exit /b 1
call :frag rpmod_copy_frag_spv glsl\rpmod\copy.frag || exit /b 1

del /Q %tmpf%
echo done: %outf%
exit /b 0

:frag
%cl% -S frag -V -o %tmpf% %2 %3 || exit /b 1
%bh% %tmpf% +%outf% %1 || exit /b 1
exit /b 0
