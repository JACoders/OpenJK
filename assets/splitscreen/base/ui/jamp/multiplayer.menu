			font				2
			textscale			.75
			textstyle			3
			textalign			ITEM_ALIGN_CENTER
			textalignx			110
			textaligny			2
			forecolor			1 .682 0 1
			backcolor			.08 .10 .16 .9
			visible				1
			action { close multiplayermenu ; open quickgame }
		}

		itemDef
		{
			name				joinserver_button
